# Copy this file to .env.local and fill in your Supabase project's values
# (Project Settings -> API in the Supabase dashboard).
#
# If these are left unset, the app still works fully offline — certificates
# just won't get a verify link. See README.md "Certificate verification".

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
