{%- macro navlink(href, label, key) -%}
<a href="{{ href }}" class="nav-link{% if navKey == key %} is-active{% endif %}"{% if navKey == key %} aria-current="page"{% endif %}>{{ label }}</a>
{%- endmacro -%}
<nav class="nav">
  <a href="/" class="nav-brand"><img src="/assets/images/zed-logo-light.png" alt="Zed Alleys" class="brand-mark" width="161" height="60"><span class="brand-word">Alleys</span></a>
  <div class="nav-links" id="navLinks">
    {{ navlink("/", "Home", "home") }}
    {{ navlink("/about.html", "About", "about") }}
    {{ navlink("/portfolio.html", "Work", "portfolio") }}
    {{ navlink("/blog.html", "Journal", "blog") }}
    {{ navlink("/contact.html", "Contact", "contact") }}
    {{ navlink("/learning-hub/", "Learning Hub", "hub") }}
  </div>
  <button class="nav-toggle" id="navToggle" aria-label="Toggle menu" aria-expanded="false" aria-controls="navLinks">
    <span class="nav-toggle-bar"></span>
    <span class="nav-toggle-bar"></span>
    <span class="nav-toggle-bar"></span>
  </button>
</nav>
